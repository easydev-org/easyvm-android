walkthrough "android 13 (blissos 16.9.7) - start the installed disk"
resolution 1920x1080
recording_resolution 1920x1080
var boot_timeout
  default "600"
  from args.boot_timeout
var out
  default out/blissos16-launch.qcow2
  from args.out


step "boot the installed disk"
  boot
    machine "q35,accel=kvm,vmport=off"
    args [["-drive", "if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"], ["-drive", "if=pflash,format=raw,file=OVMF_VARS.fd"], ["-m", "4096"], ["-chardev", "socket,id=qga0,path=qga.sock,server=on,wait=off"], ["-device", "virtio-serial"], ["-device", "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"], ["-device", "virtio-vga,xres=1920,yres=1080"], ["-device", "qemu-xhci,id=xhci"], ["-device", "usb-tablet,bus=xhci.0"], ["-device", "usb-kbd,bus=xhci.0"], ["-drive", "file=disk.qcow2,if=none,format=qcow2,discard=unmap,id=target"], ["-device", "virtio-blk-pci,drive=target,bootindex=0"], ["-audiodev", "none,id=snd0"], ["-device", "ich9-intel-hda"], ["-device", "hda-duplex,audiodev=snd0"], ["-netdev", "tap,id=net0,ifname=qemutap0,script=no,downscript=no"], ["-device", "virtio-net-pci,netdev=net0,mac=52:54:00:56:4d:01,romfile=,host_mtu=1450"]]
    timeout 300
step "the firmware found the ESP and GRUB is running"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name boot
    until
      bind reached
      source boot
      mode text
      rect [548, 689, 1184, 868]
      rect_at [1920, 1080]
      words [[blissos], [android], [grub]]
    max 60

step "wait for the home-app chooser"
  repeat
    do
      item
        settle 5
      item "read the screen"
        read
          name chooser
    until
      bind asked
      source chooser
      mode text
      rect [0, 0, 1920, 1080]
      rect_at [1920, 1080]
      words [home, app]
    max 20

step "choose Taskbar for Bliss OS"
  input 666 722
  settle 3

step "always, so the next boot goes straight to the desktop"
  input 1238 986
  settle 6

step "wait for Android's own UI"
  repeat
    do
      item
        read
          name screen
    until
      bind up
      source screen
      mode like
      reference reference/desktop.png
      range [0.80, 1]
      rect [0, 0, 1920, 900]
      rect_at [1920, 1080]
      must true
    max 120
    pause 10

step "stop the machine"
  stop kill
  timeout 120
